# Backend
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

AGENT_PROFILE=odisha
AGENT_CONFIG_DIR=backend/app/config/agents

# LLM provider: local | ollama | openai | gemini | sarvam
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:0.6b
LLM_TIMEOUT_SECONDS=60
LLM_RETRY_ATTEMPTS=2
LLM_RETRY_BASE_DELAY_SECONDS=1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
SARVAM_LLM_BASE_URL=https://api.sarvam.ai

# Planned voice configuration
SARVAM_API_KEY=
STT_PROVIDER=sarvam
STT_MODEL=saaras:v3
STT_LANGUAGE=od-IN
STT_TIMEOUT_SECONDS=30
STT_MAX_AUDIO_BYTES=10000000
TTS_PROVIDER=sarvam
TTS_MODEL=bulbul:v3
TTS_LANGUAGE=od-IN
TTS_SPEAKER=shubh
TTS_TIMEOUT_SECONDS=30
RAG_TOP_K=4
EMBEDDING_MODEL=hashing-v1
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
